# MarketPrices — environment keys (build plan §3.4)
# Never commit real values. In Codespaces these are set under
# GitHub → Settings → Codespaces → Secrets. Locally they live in .env.local,
# which is git-ignored and must never be read, printed or pasted into a
# Claude Code session (P9.6).

# Claude Code — generate on your laptop with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Supabase
# PUBLISHABLE (sb_publishable_) is public by design and ships in the client bundle.
# SECRET (sb_secret_) is server-only — P9.3 greps .next/static for it and fails the build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_ID=
DATABASE_URL=

# Anthropic API — the production chains
ANTHROPIC_API_KEY=

# YouTube Data API v3 — channel sync
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Google Search Console — service account JSON (single line)
GSC_SERVICE_ACCOUNT_JSON=

# Resend — newsletter and submission alerts
RESEND_API_KEY=

# Google Apps Script → /api/ingest/price bearer secret
PRICE_INGEST_SECRET=

# Vercel Cron — verified by every /api/cron/* route
CRON_SECRET=

# FX rate provider — non-naira conversion
FX_API_KEY=
# The Google Sheets tracker source (scripts/import-tracker.ts).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The private_key from the service account's JSON key, in DOUBLE quotes.
# Single quotes and no quotes both keep the \n literal.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# The part of the sheet's URL between /d/ and /edit.
TRACKER_SPREADSHEET_ID=
# Unused until a /api/cron/* route exists (P9.7). openssl rand -hex 32
CRON_SECRET=