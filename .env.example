# MarketPrices — environment keys (build plan §3.4)
# Never commit real values. In Codespaces these are set under
# GitHub → Settings → Codespaces → Secrets. Locally they live in .env.local,
# which is git-ignored and must never be read, printed or pasted into a
# Claude Code session (P9.6).

# Claude Code — generate on your laptop with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Anthropic API — the production chains
ANTHROPIC_API_KEY=

# YouTube Data API v3 — channel sync
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Google Search Console — service account JSON (single line)
GSC_SERVICE_ACCOUNT_JSON=

# Resend — newsletter and submission alerts
RESEND_API_KEY=

# Google Apps Script → /api/ingest/price bearer secret
PRICE_INGEST_SECRET=

# Vercel Cron — verified by every /api/cron/* route
CRON_SECRET=

# FX rate provider — non-naira conversion
FX_API_KEY=
