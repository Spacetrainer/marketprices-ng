# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report

# A captured signed-in staff session (scripts/capture-admin-session.ts). Real auth cookies
# for a real account — never commit it. Regenerate locally instead of sharing it.
# The sidecar records which role the cookies belong to; it holds no credential, but it is
# meaningless without the file it describes and is ignored with it rather than left behind.
/auth.json
/auth.meta.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data/form-options.json is NOT ignored, deliberately. scripts/generate-form-options.ts
# rebuilds it from the database and the database stays the source of truth — but
# app/api/ingest/price/route.ts reads the file from process.cwd() at REQUEST time, and
# Vercel builds from git, so an ignored file would not exist in production and every
# submission would 503. `pnpm check:form-options` fails CI if the committed copy drifts.

# supabase
# `supabase db push` writes a TLS certificate for the target here. It is generated per
# push, belongs to the connection rather than to this project, and nothing in the repo
# reads it. The rest of supabase/.temp IS tracked — it records which project this repo is
# linked to — so this ignores the one generated directory, not the folder around it.
/supabase/.temp/pgdelta/
