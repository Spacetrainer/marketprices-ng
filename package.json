{
  "name": "marketprices",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:seed": "bash scripts/check-seed.sh",
    "check:routes": "tsx scripts/check-routes.ts",
    "capture:session": "tsx scripts/capture-admin-session.ts",
    "check:vocab": "bash scripts/check-vocab.sh",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > types/database.ts",
    "db:push": "supabase db push",
    "db:seed": "psql \"${DATABASE_URL:?DATABASE_URL is not set - export it, or load .env.local first}\" -v ON_ERROR_STOP=1 -f supabase/seed.sql",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "next": "^15.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
